{
  "description": "Filters and area codes -> ArcGIS where clauses (IMPLEMENTATION_GUIDE.md §4.4). Read by tests/js/sql.test.js. Every clause shape here was run against an NJDEP server layer and an ArcGIS Online layer in the trial (docs/studio/TRIAL.md).",
  "entry": {
    "fields": [
      {"source": "NAME", "name": "name", "type": "text", "filter": "search"},
      {"source": "KIND", "name": "kind", "type": "category", "filter": "checklist"},
      {"source": "TYPE", "name": "school_type", "type": "category", "filter": "checklist", "transform": "titlecase"},
      {"source": "CODE", "name": "code", "type": "category", "filter": "checklist", "value_labels": {"1": "One", "2": "Two", "3": "One", "9": null}},
      {"source": "SUBTYPE", "name": "road_class", "type": "category", "filter": "checklist", "value_labels": {"100": "Toll highway", "108": "Ramp", "208": "Ramp"}},
      {"source": "ACRES", "name": "acres", "type": "number", "filter": "range"},
      {"source": "YEAR", "name": "year", "type": "number", "filter": "range", "transform": "zero_is_blank"},
      {"source": "AREA", "name": "area_sq_mi", "type": "number", "filter": "range", "transform": "sq_m_to_sq_mi"},
      {"source": "RED", "name": "reduction", "type": "number", "filter": "range", "transform": "share_to_percent"},
      {"source": "EFF", "name": "effective", "type": "date", "filter": "range"},
      {"source": "DEED", "name": "sale_date", "type": "date", "filter": "range", "transform": "yymmdd"}
    ]
  },
  "types": {"NAME": "string", "KIND": "string", "TYPE": "string", "CODE": "string", "SUBTYPE": "number", "ACRES": "number",
            "YEAR": "number", "AREA": "number", "RED": "number", "EFF": "date", "DEED": "string"},
  "conditions": [
    {"label": "in, one value", "conditions": [{"field": "kind", "op": "in", "values": ["Park"]}], "where": "KIND IN ('Park')"},
    {"label": "in, a quote is doubled", "conditions": [{"field": "kind", "op": "in", "values": ["Park", "O'Brien"]}], "where": "KIND IN ('Park', 'O''Brien')"},
    {"label": "in with blanks", "conditions": [{"field": "kind", "op": "in", "values": ["Park"], "include_blank": true}], "where": "(KIND IN ('Park') OR KIND IS NULL OR KIND = '')"},
    {"label": "blanks only", "conditions": [{"field": "kind", "op": "in", "values": [], "include_blank": true}], "where": "(KIND IS NULL OR KIND = '')"},
    {"label": "titlecase field compares upper-case", "conditions": [{"field": "school_type", "op": "in", "values": ["Elementary School"]}], "where": "UPPER(TYPE) IN ('ELEMENTARY SCHOOL')"},
    {"label": "a label maps back to every code", "conditions": [{"field": "code", "op": "in", "values": ["One"]}], "where": "CODE IN ('1', '3')"},
    {"label": "an unlabeled value is a source value", "conditions": [{"field": "code", "op": "in", "values": ["Two", "Other"]}], "where": "CODE IN ('2', 'Other')"},
    {"label": "codes labeled null count as blank", "conditions": [{"field": "code", "op": "in", "values": [], "include_blank": true}], "where": "(CODE IS NULL OR CODE = '' OR CODE IN ('9'))"},
    {"label": "numeric codes are not quoted", "conditions": [{"field": "road_class", "op": "in", "values": ["Ramp"]}], "where": "SUBTYPE IN (108, 208)"},
    {"label": "numeric codes, two labels", "conditions": [{"field": "road_class", "op": "in", "values": ["Toll highway", "Ramp"]}], "where": "SUBTYPE IN (100, 108, 208)"},
    {"label": "numeric blanks", "conditions": [{"field": "road_class", "op": "in", "values": [], "include_blank": true}], "where": "SUBTYPE IS NULL"},
    {"label": "contains", "conditions": [{"field": "name", "op": "contains", "value": "shell"}], "where": "UPPER(NAME) LIKE '%SHELL%' ESCAPE '\\'"},
    {"label": "contains escapes % and _", "conditions": [{"field": "name", "op": "contains", "value": "50%_off"}], "where": "UPPER(NAME) LIKE '%50\\%\\_OFF%' ESCAPE '\\'"},
    {"label": "contains doubles a quote", "conditions": [{"field": "name", "op": "contains", "value": "o'neill"}], "where": "UPPER(NAME) LIKE '%O''NEILL%' ESCAPE '\\'"},
    {"label": "number, min only", "conditions": [{"field": "acres", "op": "range", "min": 10, "max": null}], "where": "ACRES >= 10"},
    {"label": "number, max only", "conditions": [{"field": "acres", "op": "range", "min": null, "max": 5.5}], "where": "ACRES <= 5.5"},
    {"label": "number, both", "conditions": [{"field": "acres", "op": "range", "min": 1, "max": 2}], "where": "ACRES >= 1 AND ACRES <= 2"},
    {"label": "zero_is_blank leaves zeros out", "conditions": [{"field": "year", "op": "range", "min": 1900, "max": null}], "where": "YEAR >= 1900 AND YEAR <> 0"},
    {"label": "sq_m_to_sq_mi scales the bound", "conditions": [{"field": "area_sq_mi", "op": "range", "min": null, "max": 1}], "where": "AREA <= 2589988.110336"},
    {"label": "share_to_percent scales the bound", "conditions": [{"field": "reduction", "op": "range", "min": 50, "max": null}], "where": "RED >= 0.5"},
    {"label": "date range, max inclusive", "conditions": [{"field": "effective", "op": "range", "min": "2008-01-01", "max": "2020-12-31"}], "where": "EFF >= DATE '2008-01-01' AND EFF < DATE '2021-01-01'"},
    {"label": "date max in a leap year", "conditions": [{"field": "effective", "op": "range", "min": null, "max": "2020-02-28"}], "where": "EFF < DATE '2020-02-29'"},
    {"label": "yymmdd after 2000", "conditions": [{"field": "sale_date", "op": "range", "min": "2020-01-01", "max": null}], "where": "((DEED >= '200101' AND DEED <= '291231'))"},
    {"label": "yymmdd across the century", "conditions": [{"field": "sale_date", "op": "range", "min": "1995-06-01", "max": "2005-12-31"}], "where": "((DEED >= '950601' AND DEED <= '991231') OR (DEED >= '000101' AND DEED <= '051231'))"},
    {"label": "yymmdd before 1930 matches nothing", "conditions": [{"field": "sale_date", "op": "range", "min": null, "max": "1929-12-31"}], "where": "1=0"},
    {"label": "two conditions", "conditions": [{"field": "kind", "op": "in", "values": ["Park"]}, {"field": "acres", "op": "range", "min": 10, "max": null}], "where": "KIND IN ('Park') AND ACRES >= 10"},
    {"label": "an unknown field is ignored", "conditions": [{"field": "nope", "op": "in", "values": ["x"]}], "where": null},
    {"label": "no conditions", "conditions": [], "where": null}
  ],
  "areas": [
    {"label": "municipality by code", "entry": {"area_mode": "code", "area_codes": {"municipality": {"field": "PCL_MUN", "match": "mun_code"}, "county": {"field": "PCL_MUN", "match": "mun_prefix"}}},
     "area": {"level": "municipality", "county_fips": "033", "mun_code": "1709"}, "expected": {"where": "PCL_MUN = '1709'"}},
    {"label": "county by municipal code prefix", "entry": {"area_mode": "code", "area_codes": {"municipality": {"field": "PCL_MUN", "match": "mun_code"}, "county": {"field": "PCL_MUN", "match": "mun_prefix"}}},
     "area": {"level": "county", "county_fips": "033"}, "expected": {"where": "PCL_MUN LIKE '17%'"}},
    {"label": "first county", "entry": {"area_mode": "code", "area_codes": {"county": {"field": "PCL_MUN", "match": "mun_prefix"}}},
     "area": {"level": "county", "county_fips": "001"}, "expected": {"where": "PCL_MUN LIKE '01%'"}},
    {"label": "last county", "entry": {"area_mode": "code", "area_codes": {"county": {"field": "PCL_MUN", "match": "mun_prefix"}}},
     "area": {"level": "county", "county_fips": "041"}, "expected": {"where": "PCL_MUN LIKE '21%'"}},
    {"label": "county number", "entry": {"area_mode": "code", "area_codes": {"county": {"field": "CO", "match": "county_number"}}},
     "area": {"level": "county", "county_fips": "033"}, "expected": {"where": "CO = '17'"}},
    {"label": "county FIPS", "entry": {"area_mode": "code", "area_codes": {"county": {"field": "CO", "match": "county_fips"}}},
     "area": {"level": "county", "county_fips": "033"}, "expected": {"where": "CO = '033'"}},
    {"label": "county name", "entry": {"area_mode": "code", "area_codes": {"county": {"field": "COUNTY", "match": "county_name"}}},
     "area": {"level": "county", "county_fips": "013"}, "names": {"county": "Essex County"}, "expected": {"where": "UPPER(COUNTY) IN ('ESSEX', 'ESSEX COUNTY')"}},
    {"label": "no municipality code: the outline", "entry": {"area_mode": "code", "area_codes": {"county": {"field": "COUNTY", "match": "county_name"}}},
     "area": {"level": "municipality", "county_fips": "033", "mun_code": "1709"}, "expected": {"outline": "municipality"}},
    {"label": "tracts always use the outline", "entry": {"area_mode": "code", "area_codes": {"municipality": {"field": "PCL_MUN", "match": "mun_code"}}},
     "area": {"level": "tract", "county_fips": "033", "tract_geoid": "34033020100"}, "expected": {"outline": "tract"}},
    {"label": "intersects layer", "entry": {"area_mode": "intersects"},
     "area": {"level": "county", "county_fips": "033"}, "expected": {"outline": "county"}},
    {"label": "the whole state needs nothing", "entry": {"area_mode": "code", "area_codes": {"municipality": {"field": "PCL_MUN", "match": "mun_code"}}},
     "area": {"level": "state"}, "expected": {}}
  ]
}
