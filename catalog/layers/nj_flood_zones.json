{
  "$schema": "../layer.schema.json",
  "id": "nj_flood_zones",
  "title": "Flood hazard zones",
  "category": "hazards",
  "status": "published",
  "geometry": "polygon",
  "noun": {"singular": "flood hazard area", "plural": "flood hazard areas"},
  "summary": "FEMA flood zones as published by NJDEP. Zones A and AE are the 1% annual chance floodplain; V and VE add wave action. Flood hazard areas are confirmed only by an NJDEP verification.",
  "source": {
    "type": "arcgis",
    "url": "https://mapsdep.nj.gov/arcgis/rest/services/Features/Hydrography/MapServer/43",
    "where": "1=1",
    "id_field": "OBJECTID",
    "publisher": "New Jersey Department of Environmental Protection (NJDEP), with data from FEMA",
    "landing_page": "https://gisdata-njdep.opendata.arcgis.com/",
    "expected_count": {"min": 103621, "max": 114529}
  },
  "license": {
    "name": "NJDEP Data Distribution Agreement",
    "url": "https://www.arcgis.com/home/item.html?id=d4df5d8bb5e042debd4b5194bfa408a7",
    "attribution": "This map was developed using New Jersey Department of Environmental Protection Geographic Information System digital data, but this secondary product has not been verified by NJDEP and is not state-authorized or endorsed. Flood zone data: FEMA.",
    "reviewed_by": "abdul-kalam-m",
    "reviewed_on": "2026-09-27"
  },
  "fields": [
    {"source": "FLD_ZONE", "name": "flood_zone", "label": "Flood zone", "type": "category", "filter": "checklist", "popup": true},
    {"source": "ZONE_SUBTY", "name": "zone_subtype", "label": "Zone subtype", "type": "category", "filter": "checklist", "popup": true, "transform": "titlecase"}
  ],
  "label_field": "flood_zone",
  "access": "hybrid",
  "area_mode": "intersects",
  "tiles": {"min_zoom": 9, "max_zoom": 14, "max_dropped_share": 0.08},
  "styles": {
    "by_zone": {"label": "By flood zone", "kind": "categories", "field": "flood_zone", "palette": "flood", "opacity": 0.55},
    "by_subtype": {"label": "By zone subtype", "kind": "categories", "field": "zone_subtype", "palette": "okabe_ito", "opacity": 0.55}
  },
  "default_style": "by_zone",
  "legend": {"title": "Flood hazard zones"},
  "buffer_role": "both",
  "distance_query": true,
  "list_fields": ["zone_subtype"],
  "clip_mode": "cut",
  "refresh_cadence": "quarterly",
  "leave_out": [],
  "examples": [
    {"label": "1% annual chance (A, AE, VE)", "conditions": [{"field": "flood_zone", "op": "in", "values": ["A", "AE", "AO", "AH", "VE"]}]}
  ]
}
