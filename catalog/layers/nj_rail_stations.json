  "default_style": "points",
  "legend": {"title": "Passenger rail stations"},
  "buffer_role": "both",
  "distance_query": true,
  "list_fields": ["line", "amtrak"],
  "clip_mode": "mask",
  "refresh_cadence": "live",
  "leave_out": [],
