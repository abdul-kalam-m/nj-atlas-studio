    "where": "1=1",
    "id_field": "OBJECTID",
    "publisher": "NJ Department of Community Affairs (DCA), from NJ Transit and DVRPC",
    "landing_page": "https://www.arcgis.com/home/item.html?id=4e8764433a5a4eb9a323635b428c6f22",
