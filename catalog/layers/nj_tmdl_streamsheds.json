    "reviewed_by": null,
    "reviewed_on": null
  },
  "fields": [
    {"source": "SITE_NAME", "name": "name", "label": "Water", "type": "text", "filter": "search", "popup": true},
    {"source": "PARAMETER", "name": "parameter", "label": "Pollutant", "type": "category", "filter": "checklist", "popup": true},
    {"source": "TMDL_TITLE", "name": "tmdl", "label": "TMDL", "type": "category", "filter": "checklist", "popup": true},
    {"source": "TMDL_DATE", "name": "year", "label": "Year", "type": "category", "filter": "checklist", "popup": true},
    {"source": "STATUS", "name": "status", "label": "Status", "type": "category", "filter": "checklist", "popup": true},
    {"source": "FINAL_URB_NPS", "name": "urban_reduction", "label": "Urban runoff reduction", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 0, "transform": "share_to_percent"},
    {"source": "FINAL_AG_NPS", "name": "farm_reduction", "label": "Agricultural runoff reduction", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 0, "transform": "share_to_percent"},
    {"source": "NJDEPLINK", "name": "document", "label": "TMDL document", "type": "text", "filter": "none", "popup": true}
  ],
  "label_field": "name",
  "access": "live",
  "area_mode": "intersects",
  "min_zoom": 7,
  "styles": {
    "by_pollutant": {"label": "By pollutant", "kind": "categories", "field": "parameter", "palette": "okabe_ito", "opacity": 0.5, "outline": "#5B6770"},
    "urban_reduction": {"label": "Urban runoff reduction", "kind": "graduated", "field": "urban_reduction", "classes": 4, "method": "quantile", "breaks": [25, 50, 75], "palette": "reds", "opacity": 0.6},
    "outline": {"label": "Outline", "kind": "single", "color": "#1F78B4", "fill": false, "width": 1.5}
  },
  "default_style": "by_pollutant",
  "legend": {"title": "Stream TMDLs"},
  "buffer_role": "target",
  "distance_query": true,
  "list_fields": ["parameter", "urban_reduction"],
  "clip_mode": "mask",
  "refresh_cadence": "live",
  "leave_out": [],
  "export_notes": [
    {"text": "NJDEP's TMDL areas. Reductions are the TMDL's share of the load to remove; the TMDL document sets the allocations an MS4 plan addresses.", "on": ["list", "export", "print"]}
  ],
  "known_answers": [
    {"label": "Every stream TMDL area", "where": "1=1", "expected": {"min": 820, "max": 860}},
    {"label": "Phosphorus TMDL areas", "where": "PARAMETER = 'Total Phosphorus'", "expected": {"min": 1, "max": 860}}
  ],
  "examples": [
    {"label": "Phosphorus TMDLs", "conditions": [{"field": "parameter", "op": "in", "values": ["Total Phosphorus"]}]},
    {"label": "Urban runoff reduction of 50% or more", "conditions": [{"field": "urban_reduction", "op": "range", "min": 50, "max": null}]}
