{
  "$schema": "../layer.schema.json",
  "id": "nj_acs_tracts",
  "title": "Demographics (tracts)",
  "category": "community",
  "status": "published",
  "geometry": "polygon",
  "noun": {"singular": "census tract", "plural": "census tracts"},
  "summary": "Who lives in each census tract: population, age, income, poverty, housing costs and tenure, race and ethnicity, education and language, and disability, from the 2020–2024 American Community Survey 5-year estimates.",
  "source": {
    "type": "arcgis",
    "url": "https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/tigerWMS_Census2020/MapServer/6",
    "where": "STATE='34'",
    "id_field": "GEOID",
    "publisher": "U.S. Census Bureau (American Community Survey; TIGERweb geography)",
    "landing_page": "https://www.census.gov/programs-surveys/acs/data/summary-file.html",
    "expected_count": {"min": 2181, "max": 2181}
  },
  "license": {
    "name": "Public domain (U.S. Government work, 17 U.S.C. § 105)",
    "url": "https://www.copyright.gov/title17/92chap1.html#105",
    "attribution": "U.S. Census Bureau, 2020–2024 American Community Survey 5-Year Estimates; 2020 Census geography (TIGERweb)",
    "reviewed_by": "abdul-kalam-m",
    "reviewed_on": "2026-09-29"
  },
  "fields": [
    {"source": "NAME", "name": "tract_name", "label": "Census tract", "type": "text", "filter": "search", "popup": true},
    {"source": "GEOID", "name": "tract_geoid", "label": "Census tract code", "type": "text", "filter": "search", "popup": true},
    {"source": "GEOID", "name": "population", "label": "Population", "type": "number", "filter": "range", "popup": true, "unit": "people", "decimals": 0, "lookup": {"table": "acs_2024_tract", "column": "population"}},
    {"source": "GEOID", "name": "density", "label": "Population density", "type": "number", "filter": "range", "popup": true, "unit": "per sq mi", "decimals": 0, "lookup": {"table": "acs_2024_tract", "column": "density"}},
    {"source": "GEOID", "name": "median_age", "label": "Median age", "type": "number", "filter": "none", "popup": true, "unit": "years", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "median_age"}},
    {"source": "GEOID", "name": "under_18_pct", "label": "Under 18", "type": "number", "filter": "none", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "under_18_pct"}},
    {"source": "GEOID", "name": "age_65_plus_pct", "label": "65 and over", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "age_65_plus_pct"}},
    {"source": "GEOID", "name": "median_hh_income", "label": "Median household income", "type": "number", "filter": "range", "popup": true, "unit": "dollars", "decimals": 0, "lookup": {"table": "acs_2024_tract", "column": "median_hh_income"}},
    {"source": "GEOID", "name": "median_hh_income_moe", "label": "Median household income, margin (±)", "type": "number", "filter": "none", "popup": true, "unit": "dollars", "decimals": 0, "lookup": {"table": "acs_2024_tract", "column": "median_hh_income_moe"}},
    {"source": "GEOID", "name": "median_hh_income_reliability", "label": "Median household income, reliability", "type": "category", "filter": "checklist", "popup": true, "lookup": {"table": "acs_2024_tract", "column": "median_hh_income_reliability"}},
    {"source": "GEOID", "name": "per_capita_income", "label": "Per capita income", "type": "number", "filter": "none", "popup": true, "unit": "dollars", "decimals": 0, "lookup": {"table": "acs_2024_tract", "column": "per_capita_income"}},
    {"source": "GEOID", "name": "poverty_pct", "label": "Below the poverty level", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "poverty_pct"}},
    {"source": "GEOID", "name": "poverty_pct_moe", "label": "Below the poverty level, margin (±)", "type": "number", "filter": "none", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "poverty_pct_moe"}},
    {"source": "GEOID", "name": "poverty_pct_reliability", "label": "Below the poverty level, reliability", "type": "category", "filter": "checklist", "popup": true, "lookup": {"table": "acs_2024_tract", "column": "poverty_pct_reliability"}},
    {"source": "GEOID", "name": "median_home_value", "label": "Median home value", "type": "number", "filter": "range", "popup": true, "unit": "dollars", "decimals": 0, "lookup": {"table": "acs_2024_tract", "column": "median_home_value"}},
    {"source": "GEOID", "name": "median_gross_rent", "label": "Median gross rent", "type": "number", "filter": "range", "popup": true, "unit": "dollars", "decimals": 0, "lookup": {"table": "acs_2024_tract", "column": "median_gross_rent"}},
    {"source": "GEOID", "name": "renter_pct", "label": "Renter households", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "renter_pct"}},
    {"source": "GEOID", "name": "rent_burden_pct", "label": "Rent burden, 30%+ of income", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "rent_burden_pct"}},
    {"source": "GEOID", "name": "rent_burden_pct_moe", "label": "Rent burden, 30%+ of income, margin (±)", "type": "number", "filter": "none", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "rent_burden_pct_moe"}},
    {"source": "GEOID", "name": "rent_burden_pct_reliability", "label": "Rent burden, 30%+ of income, reliability", "type": "category", "filter": "checklist", "popup": true, "lookup": {"table": "acs_2024_tract", "column": "rent_burden_pct_reliability"}},
    {"source": "GEOID", "name": "vacancy_pct", "label": "Vacant housing units", "type": "number", "filter": "none", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "vacancy_pct"}},
    {"source": "GEOID", "name": "no_vehicle_pct", "label": "Households without a vehicle", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "no_vehicle_pct"}},
    {"source": "GEOID", "name": "people_of_color_pct", "label": "People of color", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "people_of_color_pct"}},
    {"source": "GEOID", "name": "white_pct", "label": "White, not Hispanic", "type": "number", "filter": "none", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "white_pct"}},
    {"source": "GEOID", "name": "black_pct", "label": "Black, not Hispanic", "type": "number", "filter": "none", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "black_pct"}},
    {"source": "GEOID", "name": "asian_pct", "label": "Asian, not Hispanic", "type": "number", "filter": "none", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "asian_pct"}},
    {"source": "GEOID", "name": "hispanic_pct", "label": "Hispanic or Latino", "type": "number", "filter": "none", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "hispanic_pct"}},
    {"source": "GEOID", "name": "bachelors_pct", "label": "Bachelor's degree or higher (age 25+)", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "bachelors_pct"}},
    {"source": "GEOID", "name": "limited_english_pct", "label": "Limited English-speaking households", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "limited_english_pct"}},
    {"source": "GEOID", "name": "disability_pct", "label": "With a disability", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 1, "lookup": {"table": "acs_2024_tract", "column": "disability_pct"}}
  ],
  "label_field": "tract_name",
  "access": "copy",
  "area_mode": "tags",
  "place_tags": "county_overlap",
  "tiles": {"min_zoom": 6, "max_zoom": 13},
  "styles": {
    "density": {"label": "Population density", "kind": "graduated", "field": "density", "classes": 6, "method": "quantile", "breaks": [1000, 2500, 5000, 10000, 20000], "palette": "blues", "opacity": 0.75, "outline": "#FFFFFF", "width": 0.5},
    "income": {"label": "Median household income", "kind": "graduated", "field": "median_hh_income", "classes": 6, "method": "quantile", "breaks": [50000, 75000, 100000, 150000, 200000], "palette": "greens", "opacity": 0.75, "outline": "#FFFFFF", "width": 0.5},
    "poverty": {"label": "Poverty rate", "kind": "graduated", "field": "poverty_pct", "classes": 5, "method": "quantile", "breaks": [5, 10, 20, 30], "palette": "reds", "opacity": 0.75, "outline": "#FFFFFF", "width": 0.5},
    "rent_burden": {"label": "Rent burden", "kind": "graduated", "field": "rent_burden_pct", "classes": 5, "method": "quantile", "breaks": [30, 40, 50, 60], "palette": "oranges", "opacity": 0.75, "outline": "#FFFFFF", "width": 0.5},
    "renters": {"label": "Renter households", "kind": "graduated", "field": "renter_pct", "classes": 5, "method": "quantile", "breaks": [20, 40, 60, 80], "palette": "purples", "opacity": 0.75, "outline": "#FFFFFF", "width": 0.5},
    "age_65": {"label": "Age 65 and over", "kind": "graduated", "field": "age_65_plus_pct", "classes": 5, "method": "quantile", "breaks": [10, 15, 20, 25], "palette": "purples", "opacity": 0.75, "outline": "#FFFFFF", "width": 0.5},
    "people_of_color": {"label": "People of color", "kind": "graduated", "field": "people_of_color_pct", "classes": 5, "method": "quantile", "breaks": [20, 40, 60, 80], "palette": "oranges", "opacity": 0.75, "outline": "#FFFFFF", "width": 0.5},
    "outline": {"label": "Outline", "kind": "single", "color": "#6A4C93", "fill": false, "width": 1}
  },
  "default_style": "density",
  "legend": {"title": "Demographics (tracts)"},
  "buffer_role": "target",
  "list_fields": ["population", "median_hh_income"],
  "clip_mode": "mask",
  "refresh_cadence": "yearly_check",
  "export_notes": [
    {"text": "2020–2024 ACS 5-year estimates, U.S. Census Bureau; dollars are 2024 dollars. Estimates carry sampling error: see the margin and reliability columns. A median at a Census limit means that value or more ($250,000 income, $2,000,000 home value, $3,500 rent).", "on": ["list", "export", "print"]}
  ],
  "leave_out": [],
  "examples": [
    {"label": "Poverty rate of 20% or more", "conditions": [{"field": "poverty_pct", "op": "range", "min": 20, "max": null}]},
    {"label": "Median household income under $50,000", "conditions": [{"field": "median_hh_income", "op": "range", "min": null, "max": 49999}]}
  ]
}
