{
  "$schema": "../layer.schema.json",
  "id": "nj_historic_districts",
  "title": "Historic districts",
  "category": "history",
  "status": "published",
  "geometry": "polygon",
  "noun": {"singular": "historic district", "plural": "historic districts"},
  "summary": "Historic districts recorded by the NJ Historic Preservation Office: listed, eligible, locally designated and identified.",
  "source": {
    "type": "arcgis",
    "url": "https://mapsdep.nj.gov/arcgis/rest/services/Features/Land/MapServer/57",
    "where": "(LOC_RESTR IS NULL OR LOC_RESTR <> 'YES') AND (DIGIPOST IS NULL OR DIGIPOST <> 5)",
    "id_field": "OBJECTID",
    "publisher": "New Jersey Department of Environmental Protection (NJDEP), Historic Preservation Office",
    "landing_page": "https://gisdata-njdep.opendata.arcgis.com/",
    "expected_count": {"min": 1966, "max": 2175}
  },
  "license": {
    "name": "NJDEP Data Distribution Agreement",
    "url": "https://www.arcgis.com/home/item.html?id=d4df5d8bb5e042debd4b5194bfa408a7",
    "attribution": "This map was developed using New Jersey Department of Environmental Protection Geographic Information System digital data, but this secondary product has not been verified by NJDEP and is not state-authorized or endorsed.",
    "reviewed_by": "abdul-kalam-m",
    "reviewed_on": "2026-09-28"
  },
  "fields": [
    {"source": "NAME", "name": "name", "label": "Name", "type": "text", "filter": "search", "popup": true},
    {"source": "ALT_NAME", "name": "other_name", "label": "Other name", "type": "text", "filter": "none", "popup": true},
    {"source": "STATUS", "name": "status", "label": "Status", "type": "category", "filter": "checklist", "popup": true, "value_labels": {"NHL": "National Historic Landmark", "LISTED": "Listed", "ELIGIBLE": "Eligible", "LOCALLY_DESIGNATED": "Locally designated", "IDENTIFIED": "Identified", "DELISTED": "Delisted", "NOT_ELIGIBLE": "Not eligible"}},
    {"source": "NRDATE", "name": "national_register", "label": "National Register", "type": "date", "filter": "range", "popup": true},
    {"source": "SRDATE", "name": "state_register", "label": "State Register", "type": "date", "filter": "range", "popup": true},
    {"source": "LOCALDATE", "name": "local_designation", "label": "Local designation", "type": "date", "filter": "none", "popup": true},
    {"source": "NHL", "name": "landmark", "label": "National Historic Landmark", "type": "category", "filter": "checklist", "popup": true, "value_labels": {"YES": "Yes", "Yes": "Yes", "NO": "No", "No": "No", "UNK": "Unknown"}}
  ],
  "label_field": "name",
  "access": "live",
  "area_mode": "intersects",
  "min_zoom": 8,
  "styles": {
    "by_status": {"label": "By status", "kind": "categories", "field": "status", "colors": {"National Historic Landmark": "#7B3F00", "Listed": "#B35806", "Eligible": "#E08214", "Locally designated": "#FDB863", "Identified": "#D8C3A5", "Delisted": "#BDBDBD", "Not eligible": "#E0E0E0"}, "opacity": 0.4},
    "outline": {"label": "Outline", "kind": "single", "color": "#8E6C3A", "fill": false, "width": 2}
  },
  "default_style": "by_status",
  "legend": {"title": "Historic districts"},
  "buffer_role": "both",
  "distance_query": true,
  "list_fields": ["status", "national_register"],
  "clip_mode": "cut",
  "refresh_cadence": "live",
  "leave_out": ["DIGISTAFF", "CREATED_USER", "LAST_EDITED_USER"],
  "examples": [
    {"label": "Listed districts", "conditions": [{"field": "status", "op": "in", "values": ["Listed", "National Historic Landmark"]}]}
  ]
}
