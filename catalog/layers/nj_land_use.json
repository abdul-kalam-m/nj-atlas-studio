{
  "$schema": "../layer.schema.json",
  "id": "nj_land_use",
  "title": "Land use (2015)",
  "category": "property",
  "status": "published",
  "geometry": "polygon",
  "noun": {"singular": "land use area", "plural": "land use areas"},
  "summary": "NJDEP's 2015 land use and land cover, mapped from aerial photography.",
  "source": {
    "type": "arcgis",
    "url": "https://mapsdep.nj.gov/arcgis/rest/services/Features/Land_lu/MapServer/13",
    "where": "1=1",
    "id_field": "OBJECTID",
    "publisher": "New Jersey Department of Environmental Protection (NJDEP)",
    "landing_page": "https://gisdata-njdep.opendata.arcgis.com/",
    "expected_count": {"min": 561010, "max": 620064}
  },
  "license": {
    "name": "NJDEP Data Distribution Agreement",
    "url": "https://www.arcgis.com/home/item.html?id=d4df5d8bb5e042debd4b5194bfa408a7",
