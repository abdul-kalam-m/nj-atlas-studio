    "reviewed_by": "abdul-kalam-m",
    "reviewed_on": "2026-09-27"
  },
  "fields": [
    {"source": "TYPE15", "name": "land_use_type", "label": "Type", "type": "category", "filter": "checklist", "popup": true, "value_labels": {"URBAN": "Urban", "AGRICULTURE": "Agriculture", "FOREST": "Forest", "WATER": "Water", "WETLANDS": "Wetlands", "BARREN LAND": "Barren land"}},
    {"source": "LABEL15", "name": "land_use", "label": "Land use", "type": "category", "filter": "checklist", "popup": true, "transform": "titlecase"},
    {"source": "IS15", "name": "impervious_pct", "label": "Impervious surface", "type": "number", "filter": "range", "popup": true, "unit": "%", "decimals": 0},
    {"source": "ACRES", "name": "acres", "label": "Area", "type": "number", "filter": "range", "popup": true, "unit": "acres", "decimals": 2}
  ],
  "label_field": "land_use",
  "access": "hybrid",
  "area_mode": "intersects",
  "tiles": {"min_zoom": 9, "max_zoom": 14},
  "styles": {
    "by_type": {"label": "By type (Anderson Level I)", "kind": "categories", "field": "land_use_type", "palette": "anderson_level1", "opacity": 0.7},
    "fill": {"label": "One color", "kind": "single", "color": "#B7A99A", "opacity": 0.5}
  },
  "default_style": "by_type",
  "legend": {"title": "Land use, 2015"},
  "buffer_role": "both",
  "distance_query": true,
  "list_fields": ["land_use_type", "acres"],
